<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="F_TravelTime" Id="{fd5d3f65-72c9-4324-9099-ac29ea3b3f38}" SpecialFunc="None">
    <Declaration><![CDATA[// Time for one axis to travel lrDist with a trapezoid profile [s]:
// reaches top speed if lrDist >= v^2/a, otherwise a triangle profile.
FUNCTION F_TravelTime : LREAL
VAR_INPUT
    lrDist  : LREAL;   // [m]
    lrVelo  : LREAL;   // max. speed [m/s]
    lrAccel : LREAL;   // acceleration = deceleration [m/s2]
END_VAR
VAR
    lrD : LREAL;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[lrD := ABS(lrDist);
IF lrD <= 0.0 OR lrVelo <= 0.0 OR lrAccel <= 0.0 THEN
    F_TravelTime := 0.0;
ELSIF lrD >= lrVelo * lrVelo / lrAccel THEN
    F_TravelTime := lrD / lrVelo + lrVelo / lrAccel;
ELSE
    F_TravelTime := 2.0 * SQRT(lrD / lrAccel);
END_IF]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>