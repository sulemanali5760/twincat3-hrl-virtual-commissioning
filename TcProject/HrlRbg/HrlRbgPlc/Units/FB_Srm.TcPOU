<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_Srm" Id="{e7e460e5-1773-4178-aa85-2ed1edfb6def}" SpecialFunc="None">
    <Declaration><![CDATA[// FB_Srm - the storage and retrieval machine (Regalbediengeraet, RBG) as a
// mode node. Its three axes are child device nodes, so one Cyclic() on the RBG
// runs the sequence first and then lets the axes move in the same scan.
//
// A job moves one load unit from a source place to a target place (either may
// be the transfer station). The sequence is the classic single cycle:
//   travel+hoist to source -> fork out -> lift -> fork in ->
//   travel+hoist to target (loaded, lifted) -> fork out -> lower -> fork in.
// Two jobs back to back (store, then retrieve) make a double cycle.
FUNCTION_BLOCK FB_Srm EXTENDS FB_ModeNode
VAR_INPUT
    eAxisKind : E_AxisKind := E_AxisKind.eSim;   // simulated axes or NC axes
    stTravelCfg : ST_AxisConfig := (lrVelocity := 3.0, lrAccel := 0.6);
    stHoistCfg  : ST_AxisConfig := (lrVelocity := 1.5, lrAccel := 0.8);
    stForkCfg   : ST_AxisConfig := (lrVelocity := 0.6, lrAccel := 0.6);
    // Manual mode (HMI): hold bJogFwd / bJogBwd to move eJogAxis, release to stop.
    eJogAxis : E_JogAxis := E_JogAxis.eTravel;
    bJogFwd  : BOOL;
    bJogBwd  : BOOL;
END_VAR
VAR_OUTPUT
    bBusy         : BOOL;         // a job is running
    bJobDone      : BOOL;         // last job finished; stays TRUE until the next StartJob
    bFault        : BOOL;         // sequence stopped on an axis fault -> ResetFault
    nJobsDone     : DINT;
    lrLastJobTime : LREAL;        // simulated duration of the last job [s]
    sLeOnFork     : STRING(20);   // load unit currently on the fork
    bJogBlocked   : BOOL;         // jog refused: fork not centred for travel / hoist
    bGotoActive   : BOOL;         // manual: driving to a GotoXY target (teach-in)
END_VAR
VAR
    fbTravel : FB_Axis(ipParent := THIS^, sNodeName := 'Travel');
    fbHoist  : FB_Axis(ipParent := THIS^, sNodeName := 'Hoist');
    fbFork   : FB_Axis(ipParent := THIS^, sNodeName := 'Fork');
    fbTravelNc : FB_AxisNc(ipParent := THIS^, sNodeName := 'TravelNc');
    fbHoistNc  : FB_AxisNc(ipParent := THIS^, sNodeName := 'HoistNc');
    fbForkNc   : FB_AxisNc(ipParent := THIS^, sNodeName := 'ForkNc');
    ipTravel : I_Axis;   // the axes the sequence uses, chosen by eAxisKind
    ipHoist  : I_Axis;
    ipFork   : I_Axis;
    fbCycle  : FB_CycleManager;
    refRack  : REFERENCE TO FB_Rack;
    stSource : ST_SlotAddr;
    stTarget : ST_SlotAddr;
    bJobPending : BOOL;
    lrJobTime   : LREAL;
    lrGotoX     : LREAL;
    lrGotoY     : LREAL;
    bJogging    : BOOL;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="Init" Id="{2606bb96-b26f-473e-a1e5-fe1aa7d8ef9d}">
      <Declaration><![CDATA[// Give the RBG the rack it works on (once, before the first job).
METHOD PUBLIC Init
VAR_INPUT
    fbRackRef : REFERENCE TO FB_Rack;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[refRack REF= fbRackRef;]]></ST>
      </Implementation>
    </Method>
    <Method Name="StartJob" Id="{d21a0b8a-2c6f-44f5-a2c5-c8a173cd4891}">
      <Declaration><![CDATA[// Accept a transport job. FALSE if busy, faulted, the addresses are invalid,
// the source is empty or the target is occupied.
METHOD PUBLIC StartJob : BOOL
VAR_INPUT
    stFrom : ST_SlotAddr;
    stTo   : ST_SlotAddr;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[StartJob := FALSE;
IF NOT __ISVALIDREF(refRack) OR bJobPending OR bFault THEN
    RETURN;
END_IF
IF NOT refRack.IsValid(stFrom) OR NOT refRack.IsValid(stTo)
   OR NOT refRack.IsOccupied(stFrom) OR refRack.IsOccupied(stTo) THEN
    RETURN;
END_IF
stSource    := stFrom;
stTarget    := stTo;
lrJobTime   := 0.0;
bJobDone    := FALSE;
bJobPending := TRUE;
fbCycle.Reset();   // so the next Call() sees a fresh start edge
StartJob := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="ResetFault" Id="{102844a4-a02d-488d-80a5-935cca5dee90}">
      <Declaration><![CDATA[// Acknowledge a fault. A load unit still on the fork stays booked on the fork.
METHOD PUBLIC ResetFault
VAR_INPUT
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[SelectAxes();
ipTravel.Reset();
ipHoist.Reset();
ipFork.Reset();
fbCycle.Reset();
bFault      := FALSE;
bJobPending := FALSE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="MoveXY" Id="{8ed925f3-320c-43ae-b443-8061ac0b0638}">
      <Declaration><![CDATA[// Travel and hoist together; done when both are in position.
METHOD PRIVATE MoveXY : E_CmdResult
VAR_INPUT
    lrX : LREAL;
    lrY : LREAL;
END_VAR
VAR
    eX, eY : E_CmdResult;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[eX := ipTravel.MoveAbs(lrX);
eY := ipHoist.MoveAbs(lrY);
IF eX = E_CmdResult.eError OR eY = E_CmdResult.eError THEN
    MoveXY := E_CmdResult.eError;
ELSIF eX = E_CmdResult.eDone AND eY = E_CmdResult.eDone THEN
    MoveXY := E_CmdResult.eDone;
ELSE
    MoveXY := E_CmdResult.eBusy;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="ForkPos" Id="{22f9f345-278f-4379-944f-3767bb6d42b9}">
      <Declaration><![CDATA[// Fork end position for a place: left side (and the station) negative, right positive.
METHOD PRIVATE ForkPos : LREAL
VAR_INPUT
    stAddr : ST_SlotAddr;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF stAddr.nSide = 2 THEN
    ForkPos := refRack.stCfg.lrForkStroke;
ELSE
    ForkPos := -refRack.stCfg.lrForkStroke;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="OnCyclic" Id="{63552c8c-7e6f-4943-849f-332cc76481a9}">
      <Declaration><![CDATA[METHOD PROTECTED OnCyclic
VAR_INPUT
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[SelectAxes();
// Axis data from the configuration (defaults = the practice RBG).
fbTravel.lrVelocity   := stTravelCfg.lrVelocity;  fbTravel.lrAccel   := stTravelCfg.lrAccel;
fbHoist.lrVelocity    := stHoistCfg.lrVelocity;   fbHoist.lrAccel    := stHoistCfg.lrAccel;
fbFork.lrVelocity     := stForkCfg.lrVelocity;    fbFork.lrAccel     := stForkCfg.lrAccel;
fbTravelNc.lrVelocity := stTravelCfg.lrVelocity;  fbTravelNc.lrAccel := stTravelCfg.lrAccel;
fbHoistNc.lrVelocity  := stHoistCfg.lrVelocity;   fbHoistNc.lrAccel  := stHoistCfg.lrAccel;
fbForkNc.lrVelocity   := stForkCfg.lrVelocity;    fbForkNc.lrAccel   := stForkCfg.lrAccel;
IF bJobPending THEN
    lrJobTime := lrJobTime + fbTravel.lrCycleTime;
END_IF
SUPER^.OnCyclic();   // dispatch to RunAutomatic / RunManual / ...
bBusy := bJobPending;]]></ST>
      </Implementation>
    </Method>
    <Method Name="RunAutomatic" Id="{1c491811-1d15-4b0c-8fa7-11cdbdd4b628}">
      <Declaration><![CDATA[METHOD PROTECTED RunAutomatic
VAR_INPUT
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT __ISVALIDREF(refRack) THEN
    RETURN;
END_IF

fbCycle.Call(bExecute := bJobPending);
CASE fbCycle.Step OF
    0:  fbCycle.Await(MoveXY(refRack.TargetX(stSource), refRack.TargetY(stSource)));
    1:  fbCycle.Await(ipFork.MoveAbs(ForkPos(stSource)));
    2:  IF fbCycle.Await(ipHoist.MoveAbs(refRack.TargetY(stSource) + refRack.stCfg.lrLiftStroke)) THEN
            sLeOnFork := refRack.Take(stSource);   // pallet is now on the fork
        END_IF
    3:  fbCycle.Await(ipFork.MoveAbs(0.0));
    4:  fbCycle.Await(MoveXY(refRack.TargetX(stTarget), refRack.TargetY(stTarget) + refRack.stCfg.lrLiftStroke));
    5:  fbCycle.Await(ipFork.MoveAbs(ForkPos(stTarget)));
    6:  IF fbCycle.Await(ipHoist.MoveAbs(refRack.TargetY(stTarget))) THEN
            refRack.Put(stTarget, sLeOnFork);      // pallet is on the beams
            sLeOnFork := '';
        END_IF
    7:  IF fbCycle.Await(ipFork.MoveAbs(0.0)) THEN
            bJobPending   := FALSE;
            bJobDone      := TRUE;
            nJobsDone     := nJobsDone + 1;
            lrLastJobTime := lrJobTime;
        END_IF
END_CASE

IF fbCycle.Error THEN
    bFault := TRUE;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="RunHoming" Id="{3df1d843-ab70-45d4-98f5-f00941161007}">
      <Declaration><![CDATA[// Go to the transfer station: fork in first, then travel and hoist.
METHOD PROTECTED RunHoming
VAR_INPUT
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT __ISVALIDREF(refRack) THEN
    RETURN;
END_IF
IF ipFork.MoveAbs(0.0) = E_CmdResult.eDone THEN
    MoveXY(0.0, refRack.stCfg.lrOffsetY);
END_IF]]></ST>
      </Implementation>
    </Method>
    <Property Name="TravelPos" Id="{45f28468-6849-42bb-b99f-59986af2f565}">
      <Declaration><![CDATA[PROPERTY PUBLIC TravelPos : LREAL]]></Declaration>
      <Get Name="Get" Id="{26c474db-6e74-4182-8d5f-dcf7a660152c}">
        <Declaration><![CDATA[VAR
END_VAR]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelectAxes();
TravelPos := ipTravel.ActPos;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="HoistPos" Id="{ca4b0749-018b-481f-8157-bb81f3af414e}">
      <Declaration><![CDATA[PROPERTY PUBLIC HoistPos : LREAL]]></Declaration>
      <Get Name="Get" Id="{754be553-2abe-486a-bad0-f3b05424f35f}">
        <Declaration><![CDATA[VAR
END_VAR]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelectAxes();
HoistPos := ipHoist.ActPos;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="ForkActPos" Id="{e243a8e7-18e4-435d-aa88-519e1c2c3c68}">
      <Declaration><![CDATA[PROPERTY PUBLIC ForkActPos : LREAL]]></Declaration>
      <Get Name="Get" Id="{9f899b6a-5aef-484c-9ceb-3aa3b4b6c7fb}">
        <Declaration><![CDATA[VAR
END_VAR]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelectAxes();
ForkActPos := ipFork.ActPos;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="InjectTravelFault" Id="{4fb8308f-ec07-4ab5-8f7f-04bf458645f9}">
      <Declaration><![CDATA[// Test and commissioning aid: simulate a fault of the travel drive.
METHOD PUBLIC InjectTravelFault
VAR_INPUT
    bFaultOn : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[fbTravel.bDriveFault := bFaultOn;]]></ST>
      </Implementation>
    </Method>
    <Method Name="GotoXY" Id="{31ac78c6-ef29-b094-2ce3-a51d916ae99a}">
      <Declaration><![CDATA[// Manual mode: drive travel and hoist to a position (fork stays centred).
// Used by teach-in to go to the nominal position of a place.
METHOD PUBLIC GotoXY : BOOL
VAR_INPUT
    lrX : LREAL;
    lrY : LREAL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF bFault OR bJobPending THEN
    RETURN;
END_IF
lrGotoX     := lrX;
lrGotoY     := lrY;
bGotoActive := TRUE;
GotoXY      := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="RunManual" Id="{af53ba23-f661-b3aa-dafb-41b450c9687a}">
      <Declaration><![CDATA[// Jog one axis while a button is held; travel and hoist only with the fork
// centred (a fork in the rack would hit the uprights). A GotoXY target has
// priority over jogging.
METHOD PROTECTED RunManual
VAR_INPUT
END_VAR
VAR
    ipAx    : I_Axis;
    lrLimit : LREAL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT __ISVALIDREF(refRack) THEN
    RETURN;
END_IF
IF bGotoActive THEN
    IF ABS(ipFork.ActPos) > 0.005 THEN
        ipFork.MoveAbs(0.0);
    ELSIF MoveXY(lrGotoX, lrGotoY) <> E_CmdResult.eBusy THEN
        bGotoActive := FALSE;
    END_IF
    RETURN;
END_IF
CASE eJogAxis OF
    E_JogAxis.eTravel:
        ipAx := ipTravel;
        IF bJogFwd THEN
            lrLimit := refRack.stCfg.lrOffsetX + INT_TO_LREAL(refRack.stCfg.nColumns - 1) * refRack.stCfg.lrPitchX;
        ELSE
            lrLimit := 0.0;
        END_IF
    E_JogAxis.eHoist:
        ipAx := ipHoist;
        IF bJogFwd THEN
            lrLimit := refRack.stCfg.lrOffsetY + INT_TO_LREAL(refRack.stCfg.nLevels - 1) * refRack.stCfg.lrPitchY
                       + refRack.stCfg.lrLiftStroke;
        ELSE
            lrLimit := refRack.stCfg.lrOffsetY;
        END_IF
    E_JogAxis.eFork:
        ipAx := ipFork;
        IF bJogFwd THEN
            lrLimit := refRack.stCfg.lrForkStroke;
        ELSE
            lrLimit := -refRack.stCfg.lrForkStroke;
        END_IF
END_CASE
bJogBlocked := eJogAxis <> E_JogAxis.eFork AND ABS(ipFork.ActPos) > 0.005 AND (bJogFwd OR bJogBwd);
IF (bJogFwd XOR bJogBwd) AND NOT bJogBlocked THEN
    ipAx.MoveAbs(lrLimit);   // runs towards the soft limit while held
    bJogging := TRUE;
ELSIF bJogging THEN
    ipAx.Halt();
    bJogging := FALSE;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="RunStop" Id="{1f0e9b52-95a2-0a24-e0a8-708918f93ec8}">
      <Declaration><![CDATA[// Stop mode: every axis halts. A running job stays pending and the sequence
// resumes from its current step when the mode is set back to automatic.
METHOD PROTECTED RunStop
VAR_INPUT
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[ipTravel.Halt();
ipHoist.Halt();
ipFork.Halt();
bGotoActive := FALSE;
bJogging    := FALSE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="SelectAxes" Id="{ae48620f-9e66-7649-aeae-7608eb506335}">
      <Declaration><![CDATA[// Point the sequence at the simulated or the NC axes. Only the chosen NC
// axes are enabled, so an unlinked NC axis never raises errors in simulation.
METHOD PRIVATE SelectAxes
VAR_INPUT
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[fbTravelNc.bEnable := eAxisKind = E_AxisKind.eNc;
fbHoistNc.bEnable  := fbTravelNc.bEnable;
fbForkNc.bEnable   := fbTravelNc.bEnable;
IF fbTravelNc.bEnable THEN
    ipTravel := fbTravelNc;
    ipHoist  := fbHoistNc;
    ipFork   := fbForkNc;
ELSE
    ipTravel := fbTravel;
    ipHoist  := fbHoist;
    ipFork   := fbFork;
END_IF]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>