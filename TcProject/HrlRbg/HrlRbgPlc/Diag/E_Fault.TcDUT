<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <DUT Name="E_Fault" Id="{a6bd7c0d-3fee-b321-9de8-28a253d1c767}">
    <Declaration><![CDATA[// Plant faults reported by FB_Diag (index into its active list).
{attribute 'qualified_only'}
{attribute 'strict'}
TYPE E_Fault :
(
    eSrmAxis      := 1,   // an RBG axis failed during a job
    eInfeedJam    := 2,
    eOutfeedJam   := 3,
    eMfrAck       := 4,   // MFR did not acknowledge TDON in time
    eMfrLinkDown  := 5,   // TCP link configured but no MFR connected
    eConfig       := 6,   // HrlConfig.json rejected, defaults in use
    eTeachRejected:= 7,   // measured place too far from the drawing
    eSafety       := 8    // safety stop or restart lock active
) INT;
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>
